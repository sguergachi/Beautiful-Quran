# Fingerprint of data/dictionary.db, enforced by DatabaseFingerprintTest.
#
# Installs cache the extracted dictionary under DictionaryDatabase.DB_FILE_NAME,
# so a dictionary whose content changed without a version bump is silently
# ignored by everyone who already has the app.
#
# Rebuilt the dictionary? Change BOTH lines below:
#   1. bump `version` and DictionaryDatabase.DB_FILE_NAME together
#   2. record the new digest: sha256sum data/dictionary.db
version=dictionary-v2.db
sha256=f33438827b3a6e405377d7e339b3ea30f15e085a47a9677add83bf0895f27e13
