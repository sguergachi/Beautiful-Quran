<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher long-press shortcuts. Each one is an ordinary VIEW deep link, so it
  works the moment the APK is installed — no registration anywhere.

  This file used to also declare Google Assistant App Actions (BII and custom
  `<capability>` elements, with query patterns in `res/values/arrays.xml`).
  Google removed Assistant from Android on 2026-09-04, which removed the voice
  entry point those capabilities existed to serve; they were dropped rather than
  left as dead metadata. Gemini reaches the same actions through AppFunctions —
  see `assistant/QuranAppFunctions.kt` and `docs/ASSISTANT.md`.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <shortcut
        android:shortcutId="continue"
        android:enabled="true"
        android:icon="@drawable/ic_launcher_foreground"
        android:shortcutShortLabel="@string/shortcut_continue_short"
        android:shortcutLongLabel="@string/shortcut_continue_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.beautifulquran"
            android:targetClass="com.beautifulquran.MainActivity"
            android:data="beautifulquran://continue" />
    </shortcut>

    <shortcut
        android:shortcutId="bookmarks"
        android:enabled="true"
        android:icon="@drawable/ic_launcher_foreground"
        android:shortcutShortLabel="@string/shortcut_bookmarks_short"
        android:shortcutLongLabel="@string/shortcut_bookmarks_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.beautifulquran"
            android:targetClass="com.beautifulquran.MainActivity"
            android:data="beautifulquran://bookmarks" />
    </shortcut>
</shortcuts>
