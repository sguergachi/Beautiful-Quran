<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (android:dataExtractionRules). Listening audio lives in
     cacheDir; exclude reproducible explicit downloads in filesDir/audio. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="audio" />
        <exclude domain="file" path="recitation-downloads" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="audio" />
        <exclude domain="file" path="recitation-downloads" />
    </device-transfer>
</data-extraction-rules>
