<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BeautifulQuran" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Cold start: solid leather until Compose paints the closed mushaf.
         Icon + icon-background match the board so Android 12's mandatory
         circle never flashes a separate mark over the ceremony. -->
    <style name="Theme.BeautifulQuran.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/cover_leather</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/cover_leather</item>
        <item name="postSplashScreenTheme">@style/Theme.BeautifulQuran</item>
    </style>
</resources>
