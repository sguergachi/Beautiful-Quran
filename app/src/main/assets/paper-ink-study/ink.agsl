uniform shader field;
uniform shader normals;
uniform float progress;
uniform float reflectionStrength;
uniform float lightSoftness;
uniform float retained;
uniform float wet;
uniform float weight;
uniform float aa;
uniform float3 repeatColor;
uniform float repeatPass;
uniform float2 origin;

half4 main(float2 p) {
    float4 shape = field.eval(p * 4.0);
    float distance = (shape.b * 255.0 - 128.0) / 16.0;
    // Letter clusters arrive in reading order; each fills through its own shape.
    float arrival = shape.g;
    float feather = max(0.006, shape.r * 0.1);
    float loaded = smoothstep(arrival - feather, arrival + feather, progress);
    float3 surface = normals.eval(p).rgb;
    float localWet = smoothstep(0.0, 0.7, wet - (1.0 - surface.b) * 0.2) * loaded;
    float base = smoothstep(-aa * 0.5, aa * 0.5, distance);
    float expanded = smoothstep(-aa * 0.5, aa * 0.5, distance + weight * localWet);
    float coverage = mix(base * 0.2661, expanded, max(loaded, retained));
    float2 slope = (surface.rg * 255.0 - 128.0) / 127.0;
    float volume = 0.6 + weight / 6.5;
    // A rounded advancing meniscus follows the same smooth arrival field as the ink.
    float rim = 4.0 * loaded * (1.0 - loaded) * wet;
    float2 frontSlope = float2(0.0);
    if (rim > 0.0) {
        float radius = max(1.5, aa * 1.5);
        frontSlope = (float2(field.eval((p + float2(radius, 0.0)) * 4.0).g,
            field.eval((p + float2(0.0, radius)) * 4.0).g) - arrival) / radius;
    }
    float3 normal = normalize(float3(slope * localWet * volume + frontSlope * rim * 6.0,
        sqrt(max(0.01, 1.0 - dot(slope, slope)))));
    float3 view = normalize(float3(0.12, -0.16, 1.0));
    float3 reflected = reflect(-view, normal);
    float2 room = reflected.xy / max(0.2, reflected.z) + (p + origin) * 0.001;
    float reflectionSoftness = mix(mix(0.1, 0.22, lightSoftness), 0.24, 1.0 - localWet);
    float lightPass = mix(-0.12, 0.12, progress * 0.8 + (1.0 - wet) * 0.2);
    float pane = min(abs(room.x + 0.32 - lightPass), abs(room.x - 0.08 - lightPass));
    float vertical = (room.y - 0.16) / 0.38;
    float window = exp(-pane * pane / (reflectionSoftness * reflectionSoftness) -
        vertical * vertical * vertical * vertical);
    float pooling = smoothstep(0.25, 0.8, surface.b);
    float3 pigment = mix(float3(6.0, 7.0, 8.0) / 255.0, repeatColor, repeatPass);
    pigment *= 1.0 - pooling * 0.2 * volume * (1.0 - repeatPass);
    pigment = mix(pigment, float3(0.86, 0.86, 0.82), window * reflectionStrength * localWet);
    float3 dry = float3(52.0, 50.0, 46.0) / 255.0;
    // Let the clean orange establish early; the liquid film may still be filling.
    float repeatDensity = wet * smoothstep(0.0, 0.35, loaded);
    float3 ink = mix(dry, pigment, mix(localWet, repeatDensity, repeatPass));
    return half4(mix(float3(250.0, 243.0, 232.0) / 255.0, ink, coverage), 1.0);
}
