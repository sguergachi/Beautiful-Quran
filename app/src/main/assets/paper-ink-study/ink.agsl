uniform shader field;
uniform shader normals;
uniform float progress;
uniform float fillMode;
uniform float2 extent;
uniform float maxDepth;
uniform float retained;
uniform float wet;
uniform float weight;
uniform float aa;
uniform float3 repeatColor;
uniform float repeatPass;
uniform float2 origin;

half4 main(float2 p) {
    float4 shape = field.eval(p * 4.0);
    float distance = (shape.b * 255.0 - 128.0) / 16.0;
    // The familiar reading-order wash drives filling inside the letterforms.
    // Its wide soft edge replaces the authored pen path and whole-word fade.
    float wash = clamp((progress * (extent.x + 60.0) - (extent.x - p.x)) / 60.0, 0.0, 1.0);
    float coordinate = mix(shape.g, shape.r, fillMode);
    float softness = mix(aa / maxDepth, aa / extent.y, fillMode);
    float loaded = wash * smoothstep(coordinate - softness, coordinate + softness,
        mix(-softness, 1.0 + softness, wash));
    float3 surface = normals.eval(p).rgb;
    float localWet = smoothstep(0.0, 0.7, wet - (1.0 - surface.b) * 0.2) * loaded;
    float base = smoothstep(-aa * 0.5, aa * 0.5, distance);
    float expanded = smoothstep(-aa * 0.5, aa * 0.5, distance + weight * localWet);
    float coverage = mix(base * 0.2661, expanded, max(loaded, retained));
    float2 slope = (surface.rg * 255.0 - 128.0) / 127.0;
    float3 normal = normalize(float3(slope * localWet,
        sqrt(max(0.01, 1.0 - dot(slope, slope)))));
    float3 view = normalize(float3(0.12, -0.16, 1.0));
    float3 reflected = reflect(-view, normal);
    float2 room = reflected.xy / max(0.2, reflected.z) + (p + origin) * 0.001;
    float reflectionSoftness = mix(0.055, 0.14, 1.0 - localWet);
    float lightPass = mix(-0.12, 0.12, progress * 0.8 + (1.0 - wet) * 0.2);
    float pane = min(abs(room.x + 0.32 - lightPass), abs(room.x - 0.08 - lightPass));
    float vertical = (room.y - 0.16) / 0.38;
    float window = exp(-pane * pane / (reflectionSoftness * reflectionSoftness) -
        vertical * vertical * vertical * vertical);
    float pooling = smoothstep(0.65, 0.95, surface.b);
    float3 pigment = mix(float3(13.0, 14.0, 15.0) / 255.0, repeatColor, repeatPass);
    pigment *= 1.0 - pooling * 0.3;
    pigment += float3(0.76, 0.76, 0.72) * window * 0.7 * localWet;
    float3 dry = float3(28.0, 27.0, 24.0) / 255.0;
    float3 ink = mix(dry, pigment, localWet);
    return half4(mix(float3(250.0, 243.0, 232.0) / 255.0, ink, coverage), 1.0);
}
