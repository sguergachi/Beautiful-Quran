// Paper ink: one word's liquid ink, drawn over the page by every reader surface.
// See docs/PAPER_INK.md. Children are generated per word on device
// (PaperInkField): field R/G = Inside out / Flowing arrival, B = signed
// outline distance (128 + 16 px); normals R/G = liquid film normal, B = the
// word's exact glyph coverage at device resolution.
uniform shader field;
uniform shader normals;
// Mask samples per device pixel in the field texture.
uniform float fieldScale;
// Device px per px of the 160 px font every constant here was tuned at.
uniform float unit;
uniform float progress;
uniform float reflectionStrength;
uniform float lightSoftness;
uniform float retained;
uniform float wet;
uniform float weight;
uniform float aa;
uniform float3 dryInk;
uniform float3 wetInk;
// Visible strength of unread text, matching the reader's upcoming cover.
uniform float unreadAlpha;
uniform float3 repeatColor;
uniform float repeatPass;
uniform float repeatTint;
uniform float spreadMethod;
uniform float letterDuration;
// Letters of fade-in ahead of the wet edge (0 disables it).
uniform float lead;
uniform float2 origin;
uniform float evaporation;

half4 inkAt(float2 p, float base, float coverageAA) {
    float4 shape = field.eval(p * fieldScale);
    float distance = (shape.b * 255.0 - 128.0) / 16.0;
    // A fine wet line down each stroke's core, swelling out to its edges.
    float arrival = mix(shape.r, shape.g, spreadMethod);
    float feather = max(0.006, letterDuration * mix(0.1, 0.12, spreadMethod));
    float loaded = smoothstep(arrival - feather, arrival + feather, progress);
    float3 surface = normals.eval(p).rgb;
    float interior = max(0.0, distance);
    float film = interior / (interior + 3.0 * unit);
    float moisture = smoothstep(0.0, 0.7, wet - (1.0 - film) * 0.2);
    float localWet = moisture * loaded;
    // Newly joined pools are fuller; their film levels behind the soaking front.
    float depositAge = max(0.0, progress - arrival) / max(0.01, letterDuration);
    float fresh = 1.0 - smoothstep(0.08, 0.65, depositAge);
    float filmWet = localWet * mix(0.82, 1.0, fresh);
    // Both passes gain weight while wet and return to the regular stroke as
    // they dry. The orange chain holds color only; it cannot hold font weight.
    float wetStrokeWeight = weight * filmWet;
    float expanded = max(base, smoothstep(-coverageAA * 0.5, coverageAA * 0.5, distance + wetStrokeWeight) * smoothstep(0.0, 0.05, filmWet));
    float2 slope = (surface.rg * 255.0 - 128.0) / 127.0;
    float volume = 0.6 + weight / (6.5 * unit);
    // A rounded advancing meniscus follows the same smooth arrival field as the ink.
    float rim = 4.0 * loaded * (1.0 - loaded) * wet;
    float2 frontSlope = float2(0.0);
    if (rim > 0.0) {
        float radius = max(0.75, 1.5 * unit);
        float2 sampleX = field.eval((p + float2(radius, 0.0)) * fieldScale).rg;
        float2 sampleY = field.eval((p + float2(0.0, radius)) * fieldScale).rg;
        frontSlope = (float2(mix(sampleX.r, sampleX.g, spreadMethod),
            mix(sampleY.r, sampleY.g, spreadMethod)) - arrival) / radius * unit;
        // Steep fronts (an ink channel swelling across its width) keep a
        // gentle bulge instead of a ridged highlight.
        frontSlope /= max(1.0, length(frontSlope) * letterDuration * 40.0);
    }
    float3 normal = normalize(float3(slope * filmWet * volume + frontSlope * rim * 6.0,
        sqrt(max(0.01, 1.0 - dot(slope, slope)))));
    float3 view = normalize(float3(0.12, -0.16, 1.0));
    float3 reflected = reflect(-view, normal);
    float2 room = reflected.xy / max(0.2, reflected.z) + (p / unit + origin) * 0.001;
    float reflectionSoftness = mix(mix(0.1, 0.22, lightSoftness), 0.24, 1.0 - localWet);
    float lightPass = mix(-0.12, 0.12, progress * 0.8 + (1.0 - wet) * 0.2);
    float pane = min(abs(room.x + 0.32 - lightPass), abs(room.x - 0.08 - lightPass));
    float vertical = (room.y - 0.16) / 0.38;
    float window = exp(-pane * pane / (reflectionSoftness * reflectionSoftness) -
        vertical * vertical * vertical * vertical);
    float pooling = smoothstep(0.25, 0.8, film);
    // Dry repeat pigment softens toward warm paper; fresh orange stays rich.
    float3 dryRepeat = mix(repeatColor, float3(0.86, 0.82, 0.77), 0.3);
    float3 wetRepeat = repeatColor;
    float3 pigment = mix(wetInk, mix(dryRepeat, wetRepeat, moisture), repeatPass);
    pigment *= 1.0 - pooling * 0.2 * volume * (1.0 - repeatPass);
    pigment = mix(pigment, float3(0.86, 0.86, 0.82), window * reflectionStrength * filmWet);
    // Both passes deposit the same liquid layer through the same soft front.
    // The repeat retains its dry underprint and holds orange after the film dries.
    float3 ink = mix(dryInk, pigment, mix(moisture, 1.0, repeatPass));
    // The letter ahead of the wet edge fades in toward fresh ink, so the edge
    // is feathered over about a letter before the liquid arrives. The repeat's
    // text is already dry; tinting it toward orange there turns muddy.
    // letterDuration = 2.8 / (letters + 1.8); arrival spans 1 - 0.24 * letterDuration.
    float slot = (1.0 - 0.24 * letterDuration) / max(1.0, 2.8 / letterDuration - 1.8);
    float approach = lead > 0.0 ? smoothstep(arrival - feather - lead * slot,
        arrival + feather, progress) * 0.6 * (1.0 - repeatPass) : 0.0;
    float3 waiting = mix(dryInk, wetInk, approach);
    float dryCoverage = base * mix(mix(unreadAlpha, 1.0, retained), 1.0, approach) * (1.0 - loaded);
    float liquidCoverage = expanded * loaded;
    // Premultiplied ink over a transparent layer: the page shows through.
    float3 color = waiting * dryCoverage + ink * liquidCoverage;
    half4 deposit = half4(color, dryCoverage + liquidCoverage);
    if (repeatPass <= 0.0) return deposit;
    // Thin edges lose their repeat film first; fuller strokes linger. The
    // soft evaporation front reveals solid dry ink, never a hole in the wash.
    float edgeDelay = 0.5 * (1.0 - smoothstep(0.0, 0.8, film));
    float repeatFilm = smoothstep(edgeDelay, edgeDelay + 0.5, repeatTint);
    return mix(half4(dryInk * base, base), deposit, repeatFilm);
}

// Integrate the wet material over the pixel rather than taking one point.
// The resting glyph coverage stays at the pixel centre in every tap: filtering
// that captured coverage again would blur the printed letters and their handoff.
half4 evaporated(half4 ink, float base) {
    float unread = base * unreadAlpha;
    return mix(ink, half4(dryInk * unread, unread), evaporation);
}

half4 main(float2 p) {
    float distance = (field.eval(p * fieldScale).b * 255.0 - 128.0) / 16.0;
    float base = normals.eval(p).b;
    if (base == 0.0 && distance < -weight - max(aa, 1.0)) return half4(0.0);
    if (wet <= 0.0) return evaporated(inkAt(p, base, aa), base);
    // Eight distinct positions along both axes resolve thin reflected lines
    // on nearly vertical alifs; a 2x2 grid has only two horizontal samples.
    float step = aa / (0.9 * 16.0);
    float tapAA = aa * 0.35355339;
    return evaporated((inkAt(p + float2(-7.0, -1.0) * step, base, tapAA) +
            inkAt(p + float2(-5.0,  5.0) * step, base, tapAA) +
            inkAt(p + float2(-3.0, -7.0) * step, base, tapAA) +
            inkAt(p + float2(-1.0,  3.0) * step, base, tapAA) +
            inkAt(p + float2( 1.0, -3.0) * step, base, tapAA) +
            inkAt(p + float2( 3.0,  7.0) * step, base, tapAA) +
            inkAt(p + float2( 5.0, -5.0) * step, base, tapAA) +
            inkAt(p + float2( 7.0,  1.0) * step, base, tapAA)) * 0.125, base);
}
